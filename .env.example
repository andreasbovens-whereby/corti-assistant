# Whereby: assistant key from the Whereby Embedded dashboard (Assistants).
WHEREBY_ASSISTANT_KEY=

# Corti: API client credentials (client credentials grant). The names match
# Corti's dashboard, so you can paste its block here.
CORTI_TENANT_NAME=
CORTI_CLIENT_ID=
CORTI_CLIENT_SECRET=
# Corti region: eu or us.
CORTI_ENVIRONMENT=eu

# Spoken language for transcription, and output language for facts and note.
PRIMARY_LANGUAGE=en

# Classic template key for the draft note (run `npm run list-templates` for the list).
NOTE_TEMPLATE_KEY=corti-soap

# Corti stream retention: none (nothing stored by Corti) or retain.
RETENTION_POLICY=none

# Regular expression matched against the Whereby participant externalId to find
# the clinician. Falls back to roleName "host" when nothing matches.
CLINICIAN_EXTERNAL_ID_PATTERN=^clinician:

# Seconds with no remote participants before the session ends.
END_GRACE_SECONDS=30

# Port for the server (webhooks, demo page, health check).
PORT=8080

# Public base URL of this server, e.g. your ngrok domain. Only used to print links.
PUBLIC_URL=

# Shared token for the demo page (at least 16 characters). A random one is generated
# and printed at startup if this is empty.
DEMO_TOKEN=

# Signing secret of the Whereby webhook (Configure > Webhooks in the dashboard).
# When set, webhooks without a valid Whereby-Signature are rejected.
WHEREBY_WEBHOOK_SECRET=

# Automatic joining: a regular expression on the room name (e.g. ^/visit-). When a
# participant joins a matching room, the Assistant joins too (needs the org webhook
# for room.client.joined). Empty (the default): the Assistant only joins when invited,
# from the room (Manual Invite) or from the demo page.
TRIGGER_ROOM_PATTERN=

# Maximum number of simultaneous sessions.
MAX_SESSIONS=4

# Optional: POST transcript, facts and note events to this URL.
OUTPUT_WEBHOOK_URL=
