# Whereby: assistant key from the Whereby Embedded dashboard (Assistants).
WHEREBY_ASSISTANT_KEY=

# Corti: API client credentials (client credentials grant). The names match
# Corti's dashboard, so you can paste its block here.
CORTI_TENANT_NAME=
CORTI_CLIENT_ID=
CORTI_CLIENT_SECRET=
# Corti region: eu or us.
CORTI_ENVIRONMENT=eu

# Spoken language for transcription, and output language for facts and note.
PRIMARY_LANGUAGE=en

# Classic template key for the draft note (run `npm run list-templates` for the list).
NOTE_TEMPLATE_KEY=corti-soap

# Corti stream retention: none (nothing stored by Corti) or retain.
RETENTION_POLICY=none

# Regular expression matched against the Whereby participant externalId to find
# the clinician. Falls back to roleName "host" when nothing matches.
CLINICIAN_EXTERNAL_ID_PATTERN=^clinician:

# Seconds with no remote participants before the session ends.
END_GRACE_SECONDS=30

# Port for the webhook listener.
PORT=8080

# Optional: POST transcript, facts and note events to this URL.
OUTPUT_WEBHOOK_URL=
